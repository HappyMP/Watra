{% set form = hookable_metadata.context.form %}

<div class="tab-pane {% if hookable_metadata.configuration.active|default(false) %}show active{% endif %}" id="product-variant-watra-event" role="tabpanel" tabindex="0">
    <div class="card mb-3">
        <div class="card-header">
            <h2 class="card-title">{{ 'app.menu.admin.main.watra.header'|trans }}</h2>
        </div>
        <div class="card-body">
            <div class="mb-3">{{ form_row(form.startsAt) }}</div>
            <div class="mb-3">{{ form_row(form.endsAt) }}</div>
            <div class="mb-3">{{ form_row(form.venue) }}</div>
        </div>
    </div>
</div>
